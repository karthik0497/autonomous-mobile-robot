<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacles_world">
    <!-- ===================================================================== -->
    <!-- GAZEBO HARMONIC WORLD SYSTEM PLUGINS                                  -->
    <!-- ===================================================================== -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- World Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ambient Lighting & Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- ARENA BOUNDARY WALLS (10m x 10m enclosure)                             -->
    <!-- ===================================================================== -->
    
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10.2 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10.2 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- WAREHOUSE OBSTACLES: TABLE, CHAIRS, STORAGE RACKS, & CARGO PALLETS     -->
    <!-- Center (0, 0) remains clear for robot spawning                          -->
    <!-- ===================================================================== -->

    <!-- 1. Warehouse Work Table (Surface + 4 Legs) -->
    <model name="warehouse_table">
      <static>true</static>
      <pose>2.0 0.0 0 0 0 0</pose>
      <link name="table_link">
        <!-- Table Top -->
        <collision name="top_col">
          <pose>0 0 0.72 0 0 0</pose>
          <geometry><box><size>1.6 0.9 0.05</size></box></geometry>
        </collision>
        <visual name="top_vis">
          <pose>0 0 0.72 0 0 0</pose>
          <geometry><box><size>1.6 0.9 0.05</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <!-- Leg 1 -->
        <collision name="leg1_col">
          <pose>0.7 0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
        </collision>
        <visual name="leg1_vis">
          <pose>0.7 0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Leg 2 -->
        <collision name="leg2_col">
          <pose>0.7 -0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
        </collision>
        <visual name="leg2_vis">
          <pose>0.7 -0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Leg 3 -->
        <collision name="leg3_col">
          <pose>-0.7 0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
        </collision>
        <visual name="leg3_vis">
          <pose>-0.7 0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Leg 4 -->
        <collision name="leg4_col">
          <pose>-0.7 -0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
        </collision>
        <visual name="leg4_vis">
          <pose>-0.7 -0.35 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 2. Chair North of Table -->
    <model name="chair_north">
      <static>true</static>
      <pose>2.0 0.80 0 0 0 0</pose>
      <link name="chair_link">
        <!-- Seat -->
        <collision name="seat_col">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.45 0.45 0.05</size></box></geometry>
        </collision>
        <visual name="seat_vis">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.45 0.45 0.05</size></box></geometry>
          <material><ambient>0.15 0.35 0.7 1</ambient><diffuse>0.15 0.35 0.7 1</diffuse></material>
        </visual>
        <!-- Backrest -->
        <collision name="back_col">
          <pose>0 0.20 0.68 0 0 0</pose>
          <geometry><box><size>0.45 0.05 0.42</size></box></geometry>
        </collision>
        <visual name="back_vis">
          <pose>0 0.20 0.68 0 0 0</pose>
          <geometry><box><size>0.45 0.05 0.42</size></box></geometry>
          <material><ambient>0.15 0.35 0.7 1</ambient><diffuse>0.15 0.35 0.7 1</diffuse></material>
        </visual>
        <!-- 4 Legs -->
        <collision name="l1_col"><pose>0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l1_vis"><pose>0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="l2_col"><pose>0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l2_vis"><pose>0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="l3_col"><pose>-0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l3_vis"><pose>-0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="l4_col"><pose>-0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l4_vis"><pose>-0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 3. Chair South of Table -->
    <model name="chair_south">
      <static>true</static>
      <pose>2.0 -0.80 0 0 0 0</pose>
      <link name="chair_link">
        <!-- Seat -->
        <collision name="seat_col">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.45 0.45 0.05</size></box></geometry>
        </collision>
        <visual name="seat_vis">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.45 0.45 0.05</size></box></geometry>
          <material><ambient>0.15 0.35 0.7 1</ambient><diffuse>0.15 0.35 0.7 1</diffuse></material>
        </visual>
        <!-- Backrest -->
        <collision name="back_col">
          <pose>0 -0.20 0.68 0 0 0</pose>
          <geometry><box><size>0.45 0.05 0.42</size></box></geometry>
        </collision>
        <visual name="back_vis">
          <pose>0 -0.20 0.68 0 0 0</pose>
          <geometry><box><size>0.45 0.05 0.42</size></box></geometry>
          <material><ambient>0.15 0.35 0.7 1</ambient><diffuse>0.15 0.35 0.7 1</diffuse></material>
        </visual>
        <!-- 4 Legs -->
        <collision name="l1_col"><pose>0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l1_vis"><pose>0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="l2_col"><pose>0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l2_vis"><pose>0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="l3_col"><pose>-0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l3_vis"><pose>-0.18 0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="l4_col"><pose>-0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="l4_vis"><pose>-0.18 -0.18 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 4. Industrial Storage Rack North-West -->
    <model name="storage_rack_nw">
      <static>true</static>
      <pose>-2.2 1.8 0.75 0 0 0</pose>
      <link name="rack_link">
        <collision name="col"><geometry><box><size>0.8 2.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 2.0 1.5</size></box></geometry>
          <material><ambient>0.2 0.45 0.3 1</ambient><diffuse>0.2 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 5. Industrial Storage Rack South-West -->
    <model name="storage_rack_sw">
      <static>true</static>
      <pose>-2.2 -1.8 0.75 0 0 0</pose>
      <link name="rack_link">
        <collision name="col"><geometry><box><size>0.8 2.0 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 2.0 1.5</size></box></geometry>
          <material><ambient>0.2 0.45 0.3 1</ambient><diffuse>0.2 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 6. Stacked Cargo Pallet North -->
    <model name="cargo_pallet_north">
      <static>true</static>
      <pose>0.0 2.8 0.4 0 0 0</pose>
      <link name="pallet_link">
        <collision name="col"><geometry><box><size>1.0 1.0 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 1.0 0.8</size></box></geometry>
          <material><ambient>0.7 0.5 0.2 1</ambient><diffuse>0.7 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 7. Stacked Cargo Pallet South -->
    <model name="cargo_pallet_south">
      <static>true</static>
      <pose>0.0 -2.8 0.4 0 0 0</pose>
      <link name="pallet_link">
        <collision name="col"><geometry><box><size>1.0 1.0 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 1.0 0.8</size></box></geometry>
          <material><ambient>0.7 0.5 0.2 1</ambient><diffuse>0.7 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
