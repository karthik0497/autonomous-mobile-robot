<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================================= -->
  <!-- RVIZ COLOR DEFINITIONS                                                    -->
  <!-- ========================================================================= -->

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>

  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0" />
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0" />
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0" />
  </material>

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0" />
  </material>

  <material name="red">
    <color rgba="0.85 0.1 0.1 1.0" />
  </material>

</robot>
